# Polymarket API Configuration
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_SECRET=your_secret_here
POLYMARKET_PASSPHRASE=your_passphrase_here

# Data Collection
SCRAPER_INTERVAL_MINUTES=10  # Supports decimals (e.g., 0.5 for 30 seconds). Minimum: 0.1 (6 seconds)
XTRACKER_URL=https://xtracker.polymarket.com
XTRACKER_USER=elonmusk

# Database
DATABASE_URL=sqlite:///data/polymarket_bot.db
TWEET_HISTORY_DIR=data/history

# Paper trading
PAPER_TRADING_START_BALANCE=1000

# Twitter/X API (optional backup)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Risk Management
MAX_POSITION_SIZE_USD=100
MAX_TOTAL_EXPOSURE_USD=500
MAX_TRADES_PER_CYCLE=5

# Runtime
AUTO_TRADE=false
TRADING_MODE=paper

# ─── Multi-Market Scanner ──────────────────────────────────────────────────────
# Scanner schedule
SCANNER_INTERVAL_MINUTES=5
PRICE_REFRESH_SECONDS=60

# Edge and sizing
MIN_EDGE_PERCENT=8
MIN_LIQUIDITY=500
MAX_KELLY_FRACTION=0.06
KELLY_MULTIPLIER=0.5
MAX_CATEGORY_EXPOSURE_PCT=25
MAX_CRYPTO_EXPOSURE_PCT=20
MAX_MARKET_EXPOSURE_PCT=10
MAX_TOTAL_EXPOSURE_PCT=80
MIN_TRADE_USD=1.50
MIN_EDGE_EXIT=3
DAILY_LOSS_LIMIT_PCT=10

# External API keys (optional - some APIs are free/no-auth)
BALLDONTLIE_API_KEY=your_balldontlie_key_here
# NOAA: free, no auth needed (User-Agent header only)
# CoinGecko: free tier, no auth needed
# DeFiLlama: free, no auth needed
# Alternative.me Fear & Greed: free, no auth needed
